<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="silverstone_track">

    <!-- Origine géographique du monde : doit être IDENTIQUE au datum
         du navsat_transform_node dans gps_ekf.yaml. Toute divergence ici
         provoque un décalage systématique entre position GPS et position
         cartésienne réelle du robot. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>49.0</latitude_deg>
      <longitude_deg>3.0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Systèmes obligatoires gz-sim (n'existaient pas sous cette forme
         sur Gazebo Classic) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Plugin NavSat : calcule un plan tangent local centré sur l'origine
         géographique ci-dessus, et convertit x,y,z Gazebo <-> lat,lon,alt
         pour tout capteur "navsat" attaché à un lien du robot -->
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- TODO : insérer ici le modèle de piste Silverstone existant
         (géométrie du circuit, obstacles, etc.) -->

  </world>
</sdf>
