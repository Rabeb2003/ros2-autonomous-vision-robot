<?xml version="1.0"?>
<robot name="diff_robot">

<material name="black">
    <color rgba="0 0 0 1.0"/>
</material>

<material name="grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
</material>

<material name="green">
    <color rgba="0.0 0.6 0 1.0"/>
</material>

<material name="white">
    <color rgba="1 1 1 1.0"/>
</material>

<!-- ==================== LINKS ==================== -->

<link name="base_footprint"/>

<link name="base_link">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="1.5"/>
        <inertia ixx="0.001665" ixy="0.0" ixz="0.0" iyy="0.00441225" iyz="0.0" izz="0.00541625"/>
    </inertial>
    <visual>
        <geometry>
            <box size="0.7 0.4 0.2"/>
        </geometry>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <material name="green"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.7 0.4 0.2"/>
        </geometry>
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    </collision>
</link>

<link name="left_wheel">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00081252" ixy="0.0" ixz="0.0" iyy="0.00081252" iyz="0.0" izz="0.0015"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
    </collision>
</link>

<link name="right_wheel">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.3"/>
        <inertia ixx="0.00081252" ixy="0.0" ixz="0.0" iyy="0.00081252" iyz="0.0" izz="0.0015"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.1" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
    </collision>
</link>

<link name="caster_wheel">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
        <geometry>
            <sphere radius="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <sphere radius="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
</link>

<link name="imu_link">
    <visual>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="grey"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
</link>

<link name="lidar_link">
    <visual>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <material name="white"/>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </collision>
    <inertial>
        <mass value="0.114"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
</link>

<link name="camera_link">
    <visual>
        <geometry>
            <box size="0.04 0.04 0.04"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="black"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.04 0.04 0.04"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
</link>

<!-- ==================== JOINTS ==================== -->

<joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.225" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.175 0.225 0.0" rpy="0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <dynamics damping="0.2" friction="1.0"/>
    <limit effort="100" velocity="10.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.175 -0.225 0.0" rpy="0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <dynamics damping="0.2" friction="1.0"/>
    <limit effort="100" velocity="10.0"/>
</joint>

<joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <dynamics damping="0.01" friction="0.0"/>
    <origin xyz="0.25 0.0 -0.05" rpy="0.0 0.0 0.0"/>
</joint>

<joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.35 0.0 0.25" rpy="0 0 0"/>
</joint>

<!-- ==================== GAZEBO CLASSIC PLUGINS & SENSORS ==================== -->

<!-- Gazebo Materials & Friction -->
<gazebo reference="base_link">
    <material>Gazebo/Green</material>
</gazebo>

<gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
</gazebo>

<gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
</gazebo>

<gazebo reference="caster_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
</gazebo>

<gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
</gazebo>

<!-- Differential Drive Plugin (ROS 2 Humble / Gazebo Classic) -->
<gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
            <namespace>/</namespace>
            <remapping>cmd_vel:=cmd_vel</remapping>
            <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.45</wheel_separation>
        <wheel_diameter>0.2</wheel_diameter>
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>1.0</max_wheel_acceleration>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
</gazebo>

<!-- Joint State Publisher Plugin -->
<gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
            <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>50</update_rate>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
    </plugin>
</gazebo>

<!-- RGB Camera Sensor Plugin (publishes on /camera/image_raw) -->
<gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
        <update_rate>30.0</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera name="front_camera">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.05</near>
                <far>50.0</far>
            </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
                <remapping>image_raw:=/camera/image_raw</remapping>
                <remapping>camera_info:=/camera/camera_info</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>camera_link</frame_name>
        </plugin>
    </sensor>
</gazebo>

<!-- 2D LiDAR Ray Sensor Plugin (publishes on /scan) -->
<gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.15</min>
                <max>12.0</max>
                <resolution>0.01</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </ray>
        <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
            <ros>
                <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>lidar_link</frame_name>
        </plugin>
    </sensor>
</gazebo>

<!-- IMU Sensor Plugin -->
<gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <remapping>~/out:=imu</remapping>
            </ros>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
    </sensor>
</gazebo>

</robot>
